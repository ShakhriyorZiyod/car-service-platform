NODE_ENV=development
LOG_LEVEL=info

# https://... Mini App: PUBLIC_URL/, admin: PUBLIC_URL/admin/. Ishlab chiqishda tunnel manzili.
PUBLIC_URL=
# Alohida TEST bot tokeni (BotFather). Production bot emas.
TELEGRAM_BOT_TOKEN=

# PostgreSQL 16+
DATABASE_URL=postgres://carservice:password@localhost:5432/carservice
# Testlar faqat shu bazaga tegadi; nomi _test bilan tugashi shart.
TEST_DATABASE_URL=postgres://carservice:password@localhost:5432/carservice_test

HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# Panel cookie'si faqat HTTPS orqali. Bo'sh: production'da true, boshqa joyda false.
COOKIE_SECURE=

# Fotolar shu papkada saqlanadi (git'ga tushmaydi).
UPLOADS_DIR=./data/uploads
# Foto havolalarini imzolash uchun, kamida 32 belgi. Production'da majburiy; ishlab chiqishda bo'sh
# qoldirsangiz, har ishga tushirishda tasodifiy yaratiladi (eski havolalar ishlamay qoladi).
MEDIA_URL_SECRET=
