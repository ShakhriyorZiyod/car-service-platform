# /etc/car-service.env (chmod 640, root:carservice). Holds the bot token, the database password and
# the photo-link secret: nobody else on the server may read it.
NODE_ENV=production
LOG_LEVEL=info

# The address both clients open: the Mini App at PUBLIC_URL/, the panel at PUBLIC_URL/admin/.
PUBLIC_URL=https://car.example.uz

# The PRODUCTION bot from BotFather, not the test one. Only one process may poll with this token.
TELEGRAM_BOT_TOKEN=

DATABASE_URL=postgres://carservice:CHANGE_ME@localhost:5432/carservice

# nginx proxies /api and /media here (deploy/nginx.example.conf).
HTTP_HOST=127.0.0.1
HTTP_PORT=3000
# The panel's cookie travels over HTTPS only. Leave it on.
COOKIE_SECURE=true

# The systemd unit creates /var/lib/car-service; backup.sh packs this directory.
UPLOADS_DIR=/var/lib/car-service/uploads
# Signs the photo links (15 minutes each). At least 32 characters: openssl rand -hex 32
MEDIA_URL_SECRET=

# backup.sh: where the copies go, how long they stay, and an off-server copy (rsync target, optional).
BACKUP_DIR=/var/backups/car-service
BACKUP_REMOTE=
